//// The HTML pages for {{.Plural}}, as plain links and forms that work without
//// JavaScript.
////
//// | Method | Route | Page |
//// | --- | --- | --- |
//// | GET | `/{{.Plural}}` | Every {{.Singular}}, in a table |
//// | GET | `/{{.Plural}}/new` | The form for a new {{.Singular}} |
//// | POST | `/{{.Plural}}` | Create, then show it |
//// | GET | `/{{.Plural}}/:id` | One {{.Singular}} |
//// | GET | `/{{.Plural}}/:id/edit` | The form to change it |
//// | POST | `/{{.Plural}}/:id` | Update, then show it |
//// | POST | `/{{.Plural}}/:id/delete` | Delete, then back to the table |
////
//// HTML forms can only GET and POST, hence POST for update and delete.
//// The layout and form helpers are in `platform/pages.gleam`.
{{if .HasKind "float"}}
import gleam/float
{{- end}}
import gleam/int
import gleam/list
import gloo/repo.{type Repo}
import howdy/controller.{type Context}
import howdy/param
import howdy/service
import howdy/ui
import howdy/ui/button
import howdy/validate
import lustre/attribute as a
import lustre/element.{type Element, text}
import lustre/element/html as h
import {{.Project.Name}}/platform/pages
import {{.Project.Name}}/{{.Plural}}/{{.Singular}}.{type New{{.Type}}, type {{.Type}}}
import {{.Project.Name}}/{{.Plural}}/{{.Plural}}

pub fn controller(db: Repo) {
  controller.new("{{.Plural}}")
  |> controller.get("/", fn(ctx) {
    case {{.Plural}}.all(db) {
      Ok(items) -> index(ctx, items)
      Error(error) -> pages.error(ctx, error)
    }
  })
  // Before "/:id", which would otherwise match "new".
  |> controller.get("/new", fn(ctx) { new(ctx, [], []) })
  |> controller.post("/", fn(ctx) {
    use form <- pages.read_form(ctx)
    case parse(form) {
      Error(errors) -> new(ctx, form, errors) |> controller.with_status(422)
      Ok(input) ->
        case {{.Plural}}.create(db, input) {
          Ok(item) -> pages.redirect(ctx, to: path(item))
          Error(error) -> pages.error(ctx, error)
        }
    }
  })
  |> controller.get("/:id", fn(ctx) {
    use id <- param.int(ctx, "id")
    case {{.Plural}}.find(db, id) {
      Ok(item) -> show(ctx, item)
      Error(error) -> pages.error(ctx, error)
    }
  })
  |> controller.get("/:id/edit", fn(ctx) {
    use id <- param.int(ctx, "id")
    case {{.Plural}}.find(db, id) {
      Ok(item) -> edit(ctx, id, to_form(item), [])
      Error(error) -> pages.error(ctx, error)
    }
  })
  |> controller.post("/:id", fn(ctx) {
    use id <- param.int(ctx, "id")
    use form <- pages.read_form(ctx)
    case parse(form) {
      Error(errors) -> edit(ctx, id, form, errors) |> controller.with_status(422)
      Ok(input) ->
        case {{.Plural}}.update(db, id, input) {
          Ok(item) -> pages.redirect(ctx, to: path(item))
          Error(error) -> pages.error(ctx, error)
        }
    }
  })
  |> controller.post("/:id/delete", fn(ctx) {
    use id <- param.int(ctx, "id")
    case {{.Plural}}.delete(db, id) {
      Ok(Nil) -> pages.redirect(ctx, to: "/{{.Plural}}")
      Error(error) -> pages.error(ctx, error)
    }
  })
}

fn path(item: {{.Type}}) -> String {
  "/{{.Plural}}/" <> int.to_string(item.id)
}

// -- Forms -------------------------------------------------------------------

/// A submitted form as a validated {{.Singular}}, or the errors to show.
fn parse(form: pages.Form) -> validate.Result(New{{.Type}}) {
{{- range .Fields}}
  {{.FormParse}}
{{- end}}
  {{.Singular}}.validate({{.Singular}}.{{.Type}}Input({{range $i, $f := .Fields}}{{if $i}}, {{end}}{{$f.Name}}:{{end}}))
}

/// The edit form starts from the stored {{.Singular}}.
fn to_form(item: {{.Type}}) -> pages.Form {
  [
{{- range .Fields}}
    #("{{.Name}}", {{.FormValue "item"}}),
{{- end}}
  ]
}

fn fields(
  form: pages.Form,
  {{.ErrorsArg}}: List(service.FieldError),
) -> List(Element(msg)) {
  [
{{- range .Fields}}
    {{.FormInput}},
{{- end}}
  ]
}

// -- Pages -------------------------------------------------------------------

fn index(ctx: Context, items: List({{.Type}})) {
  pages.layout(ctx, "{{.Title}}", [
    ui.row([], [pages.button_link(button.Primary, "/{{.Plural}}/new", "New {{.Label}}")]),
    ui.card([], [
      case items {
        [] -> ui.p([ui.muted("Nothing here yet.")])
        _ ->
          h.table([a.class("page-table")], [
            h.thead([], [
              h.tr([], [
{{- range .Fields}}
                h.th([], [text("{{.Label}}")]),
{{- end}}
                h.th([], []),
              ]),
            ]),
            h.tbody([], list.map(items, row)),
          ])
      },
    ]),
  ])
}

fn row(item: {{.Type}}) -> Element(msg) {
  h.tr([], [
{{- range .Fields}}
    h.td([], [text({{.Display "item"}})]),
{{- end}}
    h.td([a.class("page-actions")], [
      ui.link(path(item), [text("Show")]),
      text(" · "),
      ui.link(path(item) <> "/edit", [text("Edit")]),
    ]),
  ])
}

fn show(ctx: Context, item: {{.Type}}) {
  pages.layout(ctx, "{{.SingularTitle}} " <> int.to_string(item.id), [
    ui.card([], [
      h.dl([a.class("page-details")], [
{{- range .Fields}}
        h.dt([], [text("{{.Label}}")]),
        h.dd([], [text({{.Display "item"}})]),
{{- end}}
      ]),
    ]),
    h.div([a.class("page-buttons")], [
      pages.button_link(button.Primary, path(item) <> "/edit", "Edit"),
      pages.action(button.Danger, to: path(item) <> "/delete", label: "Delete"),
      ui.link("/{{.Plural}}", [text("Back to {{.PluralLabel}}")]),
    ]),
  ])
}

fn new(ctx: Context, form: pages.Form, errors: List(service.FieldError)) {
  pages.layout(ctx, "New {{.Label}}", [
    ui.card([], [
      h.form(
        [a.method("post"), a.action("/{{.Plural}}"), a.class("page-form")],
        list.append(fields(form, errors), [
          h.div([a.class("page-buttons")], [
            pages.submit(button.Primary, "Create"),
            ui.link("/{{.Plural}}", [text("Cancel")]),
          ]),
        ]),
      ),
    ]),
  ])
}

fn edit(
  ctx: Context,
  id: Int,
  form: pages.Form,
  errors: List(service.FieldError),
) {
  let path = "/{{.Plural}}/" <> int.to_string(id)
  pages.layout(ctx, "Edit {{.Label}}", [
    ui.card([], [
      h.form(
        [a.method("post"), a.action(path), a.class("page-form")],
        list.append(fields(form, errors), [
          h.div([a.class("page-buttons")], [
            pages.submit(button.Primary, "Save"),
            ui.link(path, [text("Cancel")]),
          ]),
        ]),
      ),
    ]),
  ])
}
{{if .HasKind "bool"}}
fn yes_no(value: Bool) -> String {
  case value {
    True -> "Yes"
    False -> "No"
  }
}
{{end}}
