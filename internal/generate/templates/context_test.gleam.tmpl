pub fn create_find_update_delete_test() {
  use db <- support.with_db()
  let assert Ok(item) = {{.Plural}}.create(db, first())
{{- range .Fields}}
  assert item.{{.Name}} == {{.SampleGleam}}
{{- end}}
  assert {{.Plural}}.find(db, item.id) == Ok(item)

  let assert Ok(item) = {{.Plural}}.update(db, item.id, changed())
{{- range .Fields}}
  assert item.{{.Name}} == {{.ChangedGleam}}
{{- end}}
  assert {{.Plural}}.all(db) == Ok([item])

  assert {{.Plural}}.delete(db, item.id) == Ok(Nil)
  assert {{.Plural}}.all(db) == Ok([])
}

pub fn missing_{{.Plural}}_are_not_found_test() {
  use db <- support.with_db()
  let assert Error(_) = {{.Plural}}.find(db, 42)
  let assert Error(_) = {{.Plural}}.update(db, 42, first())
  let assert Error(_) = {{.Plural}}.delete(db, 42)
}
