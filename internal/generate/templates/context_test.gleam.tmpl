}

fn changed() -> {{.Singular}}.New{{.Type}} {
  let assert Ok(input) =
    {{.Singular}}.validate({{.Singular}}.{{.Type}}Input({{range $i, $f := .Fields}}{{if $i}}, {{end}}{{$f.Name}}: {{$f.ChangedGleam}}{{end}}))
  input
