//// The JSON API for {{.Plural}}.
////
//// | Method | Route | Result |
//// | --- | --- | --- |
//// | GET | `/api/{{.Plural}}` | Every {{.Singular}}, oldest first |
//// | GET | `/api/{{.Plural}}/:id` | One {{.Singular}} |
//// | POST | `/api/{{.Plural}}` | Create; 201 |
//// | PUT | `/api/{{.Plural}}/:id` | Replace every field; 200 |
//// | DELETE | `/api/{{.Plural}}/:id` | 204 |
////
//// Validation failures return 422 with field errors; unknown ids return 404.

import gleam/json
import gloo/repo.{type Repo}
import howdy/body
import howdy/controller
import howdy/param
import howdy/service
import {{.Project.Name}}/{{.Plural}}/{{.Singular}}
import {{.Project.Name}}/{{.Plural}}/{{.Plural}}

pub fn controller(db: Repo) {
  controller.new("api/{{.Plural}}")
  |> controller.get("/", fn(ctx) {
    {{.Plural}}.all(db) |> service.respond(ctx, json.array(_, {{.Singular}}.to_json))
  })
  |> controller.get("/:id", fn(ctx) {
    use id <- param.int(ctx, "id")
    {{.Plural}}.find(db, id) |> service.respond(ctx, {{.Singular}}.to_json)
  })
  |> controller.post("/", fn(ctx) {
    use input <- body.validated(ctx, {{.Singular}}.input_decoder(), {{.Singular}}.validate)
    {{.Plural}}.create(db, input) |> service.created(ctx, {{.Singular}}.to_json)
  })
  |> controller.put("/:id", fn(ctx) {
    use id <- param.int(ctx, "id")
    use input <- body.validated(ctx, {{.Singular}}.input_decoder(), {{.Singular}}.validate)
    {{.Plural}}.update(db, id, input) |> service.respond(ctx, {{.Singular}}.to_json)
  })
  |> controller.delete("/:id", fn(ctx) {
    use id <- param.int(ctx, "id")
    {{.Plural}}.delete(db, id) |> service.no_content(ctx)
  })
}
