//// Messages from locales, generated by howdy_i18n. Do not edit:
//// change the catalogues and run `gleam run -m howdy/i18n/cli gen`.

import howdy/i18n.{type Translator}
import howdy/i18n/format
import howdy/i18n/plural

/// The locales with catalogues.
pub const locales = ["en"]

/// The locale every message is written in first.
pub const source = "en"

/// greeting: Hello, {name}!
pub fn greeting(_translator: Translator, name name: String) -> String {
  "Hello, " <> name <> "!"
}

/// items: {count, plural, =0 {No items} one {# item} other {# items}}
pub fn items(translator: Translator, count count: Int) -> String {
  case count {
    0 -> "No items"
    _ ->
      case plural.cardinal("en", count) {
        plural.One -> format.integer(translator, count) <> " item"
        _ -> format.integer(translator, count) <> " items"
      }
  }
}
