//// The form for a new {{.Singular}}, at `/{{.Plural}}/new`. It is shown
//// again with the errors when what was submitted is not valid.

import gleam/list
import howdy/controller.{type GuardedContext}
import howdy/service
import howdy/ui
import howdy/ui/button
import lustre/attribute as a
import lustre/element.{text}
import lustre/element/html as h
import {{.Project.Name}}/layouts/{{.LayoutModule}}
import {{.Project.Name}}/platform/pages
import {{.Project.FeatureImport .Plural}}/pages/helpers

pub fn show(ctx: GuardedContext(guarded), form: pages.Form, errors: List(service.FieldError)) {
  {{.LayoutModule}}.render(ctx, "New {{.Label}}", [
    ui.h1("New {{.Label}}"),
    ui.card([], [
      h.form(
        [a.method("post"), a.action("/{{.Plural}}"), a.class("page-form")],
        list.append(helpers.fields(form, errors), [
          h.div([a.class("page-buttons")], [
            pages.submit(button.Primary, "Create"),
            ui.link("/{{.Plural}}", [text("Cancel")]),
          ]),
        ]),
      ),
    ]),
  ])
}
