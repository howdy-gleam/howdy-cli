import gleam/http
import gleam/http/response
import gleam/string
import gleam/uri
import howdy/testing
import {{.Project.Name}}/support

fn submit(path: String, form: List(#(String, String))) {
  testing.request(http.Post, path)
  |> testing.text_body(uri.query_to_string(form))
  |> testing.header("content-type", "application/x-www-form-urlencoded")
}

fn first() -> List(#(String, String)) {
  [{{range .Fields}}{{.FormPair false}}{{end}}]
}

fn changed() -> List(#(String, String)) {
  [{{range .Fields}}{{.FormPair true}}{{end}}]
}

pub fn pages_lifecycle_test() {
  use db <- support.with_db()
  let app = support.app(db)

  let empty = testing.get("/{{.Plural}}") |> testing.send(app)
  assert empty.status == 200
  assert string.contains(testing.text(empty), "Nothing here yet.")
  assert testing.send(testing.get("/{{.Plural}}/new"), app).status == 200

  let created = submit("/{{.Plural}}", first()) |> testing.send(app)
  assert created.status == 303
  assert response.get_header(created, "location") == Ok("/{{.Plural}}/1")

  let shown = testing.get("/{{.Plural}}/1") |> testing.send(app)
  assert shown.status == 200
  assert string.contains(testing.text(shown), "{{.Probe.Shown false}}")
  let listed = testing.get("/{{.Plural}}") |> testing.send(app)
  assert string.contains(testing.text(listed), "{{.Probe.Shown false}}")

  // The edit form starts from the stored values.
  let editing = testing.get("/{{.Plural}}/1/edit") |> testing.send(app)
  assert editing.status == 200
  assert string.contains(testing.text(editing), "{{.Probe.InForm}}")

  let updated = submit("/{{.Plural}}/1", changed()) |> testing.send(app)
  assert updated.status == 303
  let shown = testing.get("/{{.Plural}}/1") |> testing.send(app)
  assert string.contains(testing.text(shown), "{{.Probe.Shown true}}")

  let deleted = submit("/{{.Plural}}/1/delete", []) |> testing.send(app)
  assert deleted.status == 303
  assert response.get_header(deleted, "location") == Ok("/{{.Plural}}")
  assert testing.send(testing.get("/{{.Plural}}/1"), app).status == 404
  assert testing.send(submit("/{{.Plural}}/1", changed()), app).status == 404
}
{{with .Invalid}}
pub fn invalid_form_is_shown_again_test() {
  use db <- support.with_db()
  let app = support.app(db)
  let res = submit("/{{$.Plural}}", [{{.Pairs}}]) |> testing.send(app)
  assert res.status == 422
  assert string.contains(testing.text(res), "role=\"alert\"")
  // Nothing was stored.
  let listed = testing.get("/{{$.Plural}}") |> testing.send(app)
  assert string.contains(testing.text(listed), "Nothing here yet.")
}
