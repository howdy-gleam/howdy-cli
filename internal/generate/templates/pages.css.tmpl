/* Styles for the pages `howdy create pages` writes. Yours to change; the
   command only writes this file when it is missing. */

.page-table {
  width: 100%;
  border-collapse: collapse;
}

.page-table th,
.page-table td {
  padding: 0.5rem 0.75rem;
  text-align: left;
  border-bottom: 1px solid rgba(127, 127, 127, 0.25);
}

.page-table td.page-actions {
  text-align: right;
  white-space: nowrap;
}

.page-details {
  display: grid;
  grid-template-columns: max-content 1fr;
  gap: 0.5rem 1.5rem;
  margin: 0;
}

.page-details dt {
  font-weight: 600;
}

.page-details dd {
  margin: 0;
}

.page-form {
  display: grid;
  gap: 1rem;
  max-width: 32rem;
}

.page-field {
  display: grid;
  gap: 0.35rem;
}

.page-checkbox {
  display: flex;
  gap: 0.5rem;
  align-items: center;
}

.page-error {
  margin: 0;
  color: #c0392b;
  font-size: 0.9em;
}

.page-buttons {
  display: flex;
  gap: 0.5rem;
  align-items: center;
  flex-wrap: wrap;
}

.page-button-link,
.page-button-link:hover {
  text-decoration: none;
}

.page-action {
  display: inline;
  margin: 0;
}
