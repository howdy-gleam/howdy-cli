import gleam/dynamic/decode
import gleam/json
import howdy/testing
import {{.Project.Name}}/support
import {{.Project.Name}}/{{.Plural}}/{{.Singular}}

fn first() -> json.Json {
  json.object([
{{- range .Fields}}
    #("{{.Name}}", {{.Sample}}),
{{- end}}
  ])
}

fn changed() -> json.Json {
  json.object([
{{- range .Fields}}
    #("{{.Name}}", {{.Changed}}),
{{- end}}
  ])
}

pub fn full_http_lifecycle_test() {
  use db <- support.with_db()
  let app = support.app(db)

  let created = testing.post("/api/{{.Plural}}", first()) |> testing.send(app)
  assert created.status == 201
  let assert Ok(item) = testing.json(created, {{.Singular}}.decoder())
{{- range .Fields}}
  assert item.{{.Name}} == {{.SampleGleam}}
{{- end}}

  let fetched = testing.get("/api/{{.Plural}}/1") |> testing.send(app)
  assert testing.json(fetched, {{.Singular}}.decoder()) == Ok(item)

  let updated = testing.put("/api/{{.Plural}}/1", changed()) |> testing.send(app)
  assert updated.status == 200
  let assert Ok(item) = testing.json(updated, {{.Singular}}.decoder())
{{- range .Fields}}
  assert item.{{.Name}} == {{.ChangedGleam}}
{{- end}}

  let listed = testing.get("/api/{{.Plural}}") |> testing.send(app)
  assert testing.json(listed, decode.list({{.Singular}}.decoder())) == Ok([item])

  let deleted = testing.delete("/api/{{.Plural}}/1") |> testing.send(app)
  assert deleted.status == 204
  assert testing.send(testing.get("/api/{{.Plural}}/1"), app).status == 404
  assert testing.send(testing.put("/api/{{.Plural}}/1", first()), app).status == 404
  assert testing.send(testing.delete("/api/{{.Plural}}/1"), app).status == 404
}

pub fn bad_ids_and_bodies_are_rejected_test() {
  use db <- support.with_db()
  let app = support.app(db)
  assert testing.send(testing.get("/api/{{.Plural}}/abc"), app).status == 400
  let res =
    testing.post("/api/{{.Plural}}", json.object([#("nope", json.int(1))]))
    |> testing.send(app)
  assert res.status == 400
}
{{with .FirstString}}
pub fn blank_{{.Name}}_is_rejected_test() {
  use db <- support.with_db()
  let blank =
    json.object([
{{- range $.Fields}}
      #("{{.Name}}", {{if eq .Name $.FirstString.Name}}json.string("  "){{else}}{{.Sample}}{{end}}),
{{- end}}
    ])
  let res = testing.post("/api/{{$.Plural}}", blank) |> testing.send(support.app(db))
  assert res.status == 422
  let assert Ok([error]) = testing.field_errors(res)
  assert error.field == "{{.Name}}"
}
{{end}}
