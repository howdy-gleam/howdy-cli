import gleam/http
import gleam/http/response
import gleam/string
import howdy/testing
import {{.Name}}

pub fn home_page_test() {
  let res = testing.get("/") |> testing.send({{.Name}}.app())
  assert res.status == 200
  assert response.get_header(res, "content-type")
    == Ok("text/html; charset=utf-8")
  assert string.contains(testing.text(res), "Howdy, {{.Title}}!")
}

pub fn home_page_supports_head_test() {
  let res = testing.request(http.Head, "/") |> testing.send({{.Name}}.app())
  assert res.status == 200
}

pub fn home_page_uses_theme_cookie_test() {
  let res =
    testing.get("/")
    |> testing.cookie("theme", "dark")
    |> testing.send({{.Name}}.app())
  assert string.contains(testing.text(res), "data-theme=\"dark\"")
}

pub fn assets_are_served_test() {
  let app = {{.Name}}.app()
  let ui = testing.get("/assets/ui.css") |> testing.send(app)
  assert ui.status == 200
  assert string.contains(testing.text(ui), "--howdy-primary")
  let css = testing.get("/assets/style.css") |> testing.send(app)
  assert css.status == 200
  assert response.get_header(css, "content-type") == Ok("text/css; charset=utf-8")
}

pub fn unknown_routes_are_not_found_test() {
  let app = {{.Name}}.app()
  assert testing.send(testing.get("/missing"), app).status == 404
  assert testing.send(testing.get("/gleam.toml"), app).status == 404
}
