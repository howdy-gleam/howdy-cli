//// Composition root. Build the app here and start it from `main`.
////
//// `gleam run` starts the server. `gleam dev` (see `dev/`) serves the same
//// app with hot reload{{if .Full}}, the admin and telemetry{{end}}.

import dot_env
import dot_env/env
import gleam/erlang/process
import howdy
{{- if .Full}}
import howdy/console
{{- end}}
import howdy/logger
import howdy/static
{{- if .Full}}
import howdy/telemetry
{{- end}}
import logging
import {{.Name}}/platform/not_found
import {{.Name}}/site/site_controller as site

/// Everything the app is built from, made once at startup: by `main`, by
/// `dev/` with development versions, and by the tests. Controllers take what
/// they need from it, and `howdy add` puts what it installs here.
pub type Services {
  Services
}

/// The app without a listener, so tests can send requests through it with
/// `howdy/testing`. Register new controllers here. Rename `_services` to
/// `services` once a controller needs something from it.
pub fn app(_services: Services) -> howdy.App {
  howdy.new()
  |> howdy.controller(site.controller())
  // The root static controller is a catch-all, so mount it last.
  |> howdy.controller(static.serve("/", from: "priv/public"))
  // People get the 404 page, API clients JSON: see platform/not_found.gleam.
  |> howdy.middleware(not_found.middleware)
}

/// Configure logging and load `.env` from the working directory. Call once
/// at startup. Set `DOT_ENV_PATH` to read a different file.
pub fn load_environment() -> Nil {
  logging.configure()
  dot_env.new_with_path(env.get_string_or("DOT_ENV_PATH", ".env"))
  |> dot_env.load
}

/// The app with request logging, bound to localhost on `PORT`.
pub fn configured(services: Services) -> howdy.App {
  let port = env.get_int_or("PORT", 8787)
  let assert True = port > 0 && port <= 65_535 as "PORT must be 1-65535"
  app(services)
  |> howdy.middleware(logger.log)
  |> howdy.bind("127.0.0.1")
  |> howdy.listening(port)
}

{{- if .Full}}

/// The key the services are exposed under, for `src/console.gleam`.
/// Declare it once, here.
pub fn services_key() -> console.Key(Services) {
  console.key("{{.Name}}")
}

/// Make the services available to a console on this node. Call once at
/// startup, never per request.
pub fn expose(services: Services) -> Nil {
  console.expose(services_key(), services)
}

/// Send a trace of every request to an OpenTelemetry collector when
/// `OTEL_EXPORTER_OTLP_ENDPOINT` is set, such as `http://localhost:4318`.
/// Without it nothing is recorded or sent. `gleam dev` records into the
/// admin instead.
pub fn start_telemetry() -> Nil {
  case telemetry.from_env("{{.Name}}") {
    Ok(config) -> {
      let assert Ok(Nil) = telemetry.start(config)
      Nil
    }
    Error(Nil) -> Nil
  }
}
{{- end}}

pub fn main() -> Nil {
  load_environment()
{{- if .Full}}
  start_telemetry()
{{- end}}
  let services = Services
{{- if .Full}}
  expose(services)
{{- end}}
  let assert Ok(_) = configured(services) |> howdy.start
  process.sleep_forever()
}
