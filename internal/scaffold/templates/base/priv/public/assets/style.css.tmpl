/* Project styles. Howdy UI's own classes come from ui.css. */

body {
  margin: 0;
  min-height: 100vh;
}

.home-list {
  margin: 0;
  padding-left: 1.25rem;
  line-height: 1.7;
}

.home-list code {
  font-size: 0.9em;
  padding: 0.1em 0.35em;
  border-radius: 0.3em;
  background: rgba(127, 127, 127, 0.15);
}
