/* Project styles. Howdy UI's own classes come from ui.css. */

body {
  margin: 0;
  min-height: 100vh;
}

/* The header every layout in src/{{.Name}}/layouts/ starts with. */
.site-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.5rem 0;
}

.home-list {
  margin: 0;
  padding-left: 1.25rem;
  line-height: 1.7;
}

.home-list code {
  font-size: 0.9em;
  padding: 0.1em 0.35em;
  border-radius: 0.3em;
  background: rgba(127, 127, 127, 0.15);
}
