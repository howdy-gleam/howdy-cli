{{- if .API}}
//// `gleam dev`: the same app with hot reload. Changes under `src/` rebuild
//// it, and the next request uses the new code.
{{- else}}
//// `gleam dev`: the same app with hot reload. Changes under `src/` rebuild
//// and refresh open pages; changes under `priv/public/` refresh them too.
{{- end}}
//// Restart after editing `dev/`, `gleam.toml` or `.env`.
{{- if .Full}}
////
//// The admin at `/_howdy` shows every request as a trace of what it did
//// and the log lines it wrote. It is a dev dependency and lives only here,
//// so `gleam run` and deployments never include it.
{{- end}}

import gleam/erlang/process
{{- if not .API}}
import howdy
{{- end}}
{{- if .Full}}
import howdy/admin
{{- end}}
import howdy/dev
{{- if .Full}}
import howdy/telemetry
import howdy/telemetry/recorder
{{- end}}
import {{.Name}}
{{- if not .API}}
import {{.Name}}/site/site_controller as site
{{- end}}

pub fn main() -> Nil {
  {{.Name}}.load_environment()
  let services = {{.Name}}.Services
{{- if .Full}}
  // For a console attached to this server: see src/console.gleam.
  {{.Name}}.expose(services)
{{- end}}
{{- if .Full}}
  // Keep the newest 200 traces in memory for the admin's Telemetry pages.
  let recorder = recorder.new(keep: 200)
  let assert Ok(Nil) =
    telemetry.new("{{.Name}}")
    |> telemetry.record(recorder)
    |> telemetry.start
  let dashboard =
    admin.new() |> admin.named("{{.Title}}") |> admin.telemetry(recorder)
{{- end}}
  let assert Ok(_) =
    dev.new(fn() {
      {{.Name}}.configured(services)
{{- if not .API}}
      |> howdy.controller(site.stylesheet())
{{- end}}
{{- if .Full}}
      |> admin.mount(dashboard)
{{- end}}
    })
{{- if not .API}}
    |> dev.watch("priv/public")
{{- end}}
    |> dev.run
  process.sleep_forever()
}
