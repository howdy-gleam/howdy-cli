/* Project styles. Howdy UI's own classes come from ui.css. The live todo
   list adopts this stylesheet into its shadow root, so these apply there. */

body {
  margin: 0;
  min-height: 100vh;
}

.home-list {
  margin: 0;
  padding-left: 1.25rem;
  line-height: 1.7;
}

.home-list code {
  font-size: 0.9em;
  padding: 0.1em 0.35em;
  border-radius: 0.3em;
  background: rgba(127, 127, 127, 0.15);
}

.todo-form {
  display: flex;
  gap: 0.5rem;
  align-items: stretch;
}

.todo-form input {
  flex: 1;
}

.todo-notice {
  margin: 0.5rem 0 0;
  color: #c0392b;
}

.todo-list {
  list-style: none;
  margin: 1rem 0 0;
  padding: 0;
}

.todo-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 0.5rem 0;
  border-top: 1px solid rgba(127, 127, 127, 0.25);
}

.todo-label {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  cursor: pointer;
}

.todo-row.done span {
  text-decoration: line-through;
  opacity: 0.6;
}
