//// The home page and the socket for its live todo list. Add routes here,
//// or create more controllers and register them in `src/{{.Name}}.gleam`.

import gleam/http
import gloo/repo.{type Repo}
import howdy/controller
import howdy/ui
import howdy/ui/live
import howdy/ui/theme
import {{.Name}}/features/home/components/todo_list_live_component
import {{.Name}}/features/home/pages/index

pub fn controller(db: Repo) {
  controller.new("")
  |> controller.get("/", index.show)
  |> controller.route(http.Head, "/", index.show)
  |> controller.get("/live/todos", fn(ctx) {
    live.serve(ctx, todo_list_live_component.app(db), with: Nil)
  })
}

/// Serves the Howdy UI stylesheet during `gleam dev`, so theme changes show
/// up without a build step. `gleam run` serves the published copy from
/// `priv/public/assets/ui.css`; regenerate it with `gleam run -m tasks/css`.
pub fn stylesheet() {
  ui.stylesheet(at: "/assets/ui.css", themes: theme.default_themes())
}
