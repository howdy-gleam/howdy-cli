//// The home page, served at `/` by `home_controller.gleam`. The todo list
//// is a live component mounted from the socket that controller serves.

import howdy/controller
import howdy/ui
import howdy/ui/live
import lustre/attribute as a
import lustre/element.{text}
import lustre/element/html as h
import {{.Name}}/layouts/default_layout

pub fn show(ctx: controller.Context) {
  default_layout.render_live(ctx, "{{.Title}}", [
    ui.h1("Howdy, {{.Title}}!"),
    ui.p([
      text("Your new Howdy project is running. "),
      ui.muted("Edit this page and it reloads while gleam dev is running."),
    ]),
    live.mount("/live/todos"),
    h.noscript([], [
      ui.p([
        text(
          "Enable JavaScript to use the todo list, or use the JSON API at /api/todos.",
        ),
      ]),
    ]),
    ui.card([], [
      ui.h2("Where things are"),
      h.ul([a.class("home-list")], [
        h.li([], [
          h.code([], [text("src/{{.Name}}/features/home/pages/index.gleam")]),
          text(" renders this page, and "),
          h.code([], [
            text(
              "src/{{.Name}}/features/home/components/todo_list_live_component.gleam",
            ),
          ]),
          text(" is the live todo list above."),
        ]),
        h.li([], [
          h.code([], [text("src/{{.Name}}/features/todos/")]),
          text(" holds the record, the database operations and the JSON API at "),
          h.code([], [text("/api/todos")]),
          text("."),
        ]),
        h.li([], [
          h.code([], [text("src/{{.Name}}/migrations/")]),
{{- if eq .Database "postgres"}}
          text(" holds the schema; the database is PostgreSQL, started with "),
          h.code([], [text("docker compose up -d")]),
          text("."),
{{- else}}
          text(" holds the schema; the database is "),
          h.code([], [text("{{.Name}}.sqlite3")]),
          text("."),
{{- end}}
        ]),
        h.li([], [
          h.code([], [text("src/{{.Name}}/layouts/")]),
          text(" holds the layouts pages share, such as the header above."),
        ]),
        h.li([], [
          h.code([], [text("src/{{.Name}}.gleam")]),
          text(" opens the database and registers controllers."),
        ]),
        h.li([], [
          h.code([], [text("priv/public/")]),
          text(" holds static files, served from the site root."),
        ]),
        h.li([], [
          h.code([], [text("test/")]),
{{- if eq .Database "postgres"}}
          text(" runs each test against an emptied test database."),
{{- else}}
          text(" runs each test against a fresh in-memory database."),
{{- end}}
        ]),
      ]),
    ]),
    ui.card([], [
      ui.h2("Learn more"),
      ui.p([
        ui.link("https://gleam.run/documentation/", [text("Gleam docs")]),
        text(" · "),
        ui.link("https://hexdocs.pm/gloo/", [text("Gloo")]),
        text(" · "),
        ui.link("https://hexdocs.pm/lustre/", [text("Lustre")]),
        text(" · "),
        ui.muted("Howdy's README lives in the checkout next to this project."),
      ]),
    ]),
  ])
}
