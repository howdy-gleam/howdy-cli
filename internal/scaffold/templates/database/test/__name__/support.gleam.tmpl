//// Test helpers: every test gets a fresh, migrated in-memory database.

import exception
import gloo/adapter/sqlite
import gloo/repo.{type Repo}
import {{.Name}}
import {{.Name}}/platform/database
import {{.Name}}/features/todos/todo_item

pub fn with_db(run_test: fn(Repo) -> a) -> a {
  let assert Ok(db) = sqlite.start(sqlite.memory())
  // Close the database even when the test fails: a failed assertion
  // crashes the test, so a plain call after it would not run.
  use <- exception.defer(fn() {
    let _ = repo.close(db)
    Nil
  })
  let assert Ok(_) = database.migrate(db)
  run_test(db)
}

/// The app as the tests see it, with the services it would get at startup.
pub fn app(db: Repo) {
  let services = {{.Name}}.Services(db:)
  {{.Name}}.app(services)
}

/// Fixtures go through the same validator as requests.
pub fn new_todo(title: String) -> todo_item.NewTodo {
  let assert Ok(input) = todo_item.validate(todo_item.TodoInput(title:))
  input
}
