name = "{{.Name}}"
version = "0.1.0"

description = "A Howdy {{if .API}}API server{{else}}web application{{end}} with a SQLite database"
target = "erlang"

[dependencies]
gleam_stdlib = ">= 1.0.0 and < 2.0.0"
gleam_erlang = ">= 1.3.0 and < 2.0.0"
gleam_http = ">= 4.4.0 and < 5.0.0"
gleam_json = ">= 3.1.0 and < 4.0.0"
logging = ">= 1.5.0 and < 2.0.0"
{{- if not .API}}
lustre = ">= 5.7.0 and < 6.0.0"
{{- end}}
dot_env = ">= 1.3.0 and < 2.0.0"
gloo = ">= 1.0.2 and < 2.0.0"
{{dependency "howdy"}}
{{- if not .API}}
{{dependency "howdy_ui"}}
{{- end}}
{{dependency "howdy_database"}}
{{- if .Full}}
{{dependency "howdy_telemetry"}}
{{- end}}

[dev_dependencies]
{{dependency "howdy_dev"}}
{{- if .Full}}
{{dependency "howdy_admin"}}
gsh = ">= 1.3.0 and < 2.0.0"
{{- end}}
gleeunit = ">= 1.0.0 and < 2.0.0"
{{- if .Full}}

# The console: `gleam run -m gsh`. Every session imports these modules;
# src/console.gleam holds the shortcuts.
[tools.gsh]
imports = ["console", "gleam/list", "gleam/option", "gleam/result"]
{{- end}}
