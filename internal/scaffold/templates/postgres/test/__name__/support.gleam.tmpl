//// Test helpers: every test gets the test database freshly migrated, with
//// nothing left from the one before. Tests run one at a time, so they can
//// share it.
////
//// The database is `TEST_DATABASE_URL`, by default the {{.Name}}_test database
//// that `docker compose up -d` creates. Never point it at data you care
//// about: its public schema is dropped and made again before every test.

import dot_env/env
import exception
import gleam/result
import gloo/repo.{type Repo}
import {{.Name}}
import {{.Name}}/platform/database
import {{.Name}}/features/todos/todo_item

const default_url = "postgres://postgres:postgres@127.0.0.1:5432/{{.Name}}_test"

pub fn with_db(run_test: fn(Repo) -> a) -> a {
  let db = connect()
  // Close the database even when the test fails: a failed assertion
  // crashes the test, so a plain call after it would not run.
  use <- exception.defer(fn() {
    let _ = repo.close(db)
    Nil
  })
  let assert Ok(_) = reset(db)
  let assert Ok(_) = database.migrate(db)
  run_test(db)
}

/// Called before the tests start, so a server that is not running fails the
/// run once instead of once per test.
pub fn check_database() -> Nil {
  let _ = repo.close(connect())
  Nil
}

fn connect() -> Repo {
  case database.connect(env.get_string_or("TEST_DATABASE_URL", default_url)) {
    Ok(db) -> db
    Error(message) -> panic as { "TEST_DATABASE_URL: " <> message }
  }
}

/// Drops everything the last test left, rather than emptying the tables:
/// Howdy packages such as auth and flags keep their migrations in the
/// database and seed rows as they migrate, which emptied tables would lose.
fn reset(db: Repo) {
  use _ <- result.try(repo.execute(db, "DROP SCHEMA IF EXISTS public CASCADE", []))
  repo.execute(db, "CREATE SCHEMA public", [])
}

/// The app as the tests see it, with the services it would get at startup.
pub fn app(db: Repo) {
  let services = {{.Name}}.Services(db:)
  {{.Name}}.app(services)
}

/// Fixtures go through the same validator as requests.
pub fn new_todo(title: String) -> todo_item.NewTodo {
  let assert Ok(input) = todo_item.validate(todo_item.TodoInput(title:))
  input
}
