# Copy to .env for local configuration. File values override exported variables.
PORT=8787
# The address to listen on: 127.0.0.1 unless set. Use 0.0.0.0 in a container.
# HOST=127.0.0.1
# These match the server started by `docker compose up -d`.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/{{.Name}}_dev
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/{{.Name}}_test
# Set to false where migrations run as a step of their own, before the app
# starts: gleam run -m tasks/migrate{{if .Docker}}, or bin/start migrate in the image{{end}}.
# MIGRATE_ON_START=true
