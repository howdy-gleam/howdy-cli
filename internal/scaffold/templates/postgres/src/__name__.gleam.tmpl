//// Composition root. The database pool is started once here and passed to the
//// slices that need it.
////
//// `gleam run` starts the server. `gleam dev` (see `dev/`) serves the same
//// app with hot reload{{if .Full}}, the admin and telemetry{{end}}.

import dot_env
import dot_env/env
{{- if not .API}}
import gleam/erlang/application
{{- end}}
import gleam/erlang/process
import gloo/repo.{type Repo}
import howdy
{{- if .Full}}
import howdy/console
{{- end}}
import howdy/logger
{{- if .API}}
import howdy/service
{{- else}}
import howdy/static
{{- end}}
{{- if .Full}}
import howdy/telemetry
{{- end}}
import logging
{{- if .API}}
import {{.Name}}/features/health/health_controller as health
{{- end}}
import {{.Name}}/platform/database
{{- if not .API}}
import {{.Name}}/platform/not_found
import {{.Name}}/features/home/home_controller as home
{{- end}}
import {{.Name}}/features/todos/todo_controller as todos

/// Everything the app is built from, made once at startup: by `main`, by
/// `dev/` with development versions, and by the tests. Controllers take what
/// they need from it, and `howdy add` puts what it installs here.
pub type Services {
  Services(db: Repo)
}

/// The app without a listener, so tests can send requests through it with
/// `howdy/testing`. Register new controllers here.
pub fn app(services: Services) -> howdy.App {
  let db = services.db
  howdy.new()
  |> howdy.controller(todos.controller(db))
{{- if .API}}
  |> howdy.controller(health.controller())
  // A request no route matches gets the same JSON error as a controller's.
  |> howdy.not_found(fn(ctx) {
    service.error_response(ctx, service.NotFound("Not found"))
  })
{{- else}}
  |> howdy.controller(home.controller(db))
  // The root static controller is a catch-all, so mount it last.
  |> howdy.controller(static.serve("/", from: public_directory()))
  // People get the 404 page, API clients JSON: see platform/not_found.gleam.
  |> howdy.middleware(not_found.middleware)
{{- end}}
}

{{- if not .API}}

/// The files served from the site root: the app's `priv/public`, found
/// through the application rather than the working directory, so they are
/// served wherever the app starts from, such as a release made by
/// `gleam export erlang-shipment`.
pub fn public_directory() -> String {
  case application.priv_directory("{{.Name}}") {
    Ok(priv) -> priv <> "/public"
    Error(Nil) -> "priv/public"
  }
}
{{- end}}

/// Configure logging and load `.env` from the working directory. Call once
/// at startup. Set `DOT_ENV_PATH` to read a different file.
pub fn load_environment() -> Nil {
  logging.configure()
  dot_env.new_with_path(env.get_string_or("DOT_ENV_PATH", ".env"))
  |> dot_env.load
}

/// Connect to the PostgreSQL database named by `DATABASE_URL`. Start the
/// local one with `docker compose up -d`.
pub fn database() -> Repo {
  let url = env.get_string_or("DATABASE_URL", database.default_url)
  case database.connect(url) {
    Ok(db) -> db
    Error(message) -> panic as { "DATABASE_URL: " <> message }
  }
}
{{- if .Full}}

/// The key the services are exposed under, for `src/console.gleam`.
/// Declare it once, here.
pub fn services_key() -> console.Key(Services) {
  console.key("{{.Name}}")
}

/// Make the services available to a console on this node. Call once at
/// startup, never per request.
pub fn expose(services: Services) -> Nil {
  console.expose(services_key(), services)
}

/// Send a trace of every request to an OpenTelemetry collector when
/// `OTEL_EXPORTER_OTLP_ENDPOINT` is set, such as `http://localhost:4318`.
/// Without it nothing is recorded or sent. `gleam dev` records into the
/// admin instead.
pub fn start_telemetry() -> Nil {
  case telemetry.from_env("{{.Name}}") {
    Ok(config) -> {
      let assert Ok(Nil) = telemetry.start(config)
      Nil
    }
    Error(Nil) -> Nil
  }
}
{{- end}}

/// The app with request logging, listening on `HOST` and `PORT`. `HOST` is
/// `127.0.0.1` unless set, so only this machine can connect; in a
/// container, set it to `0.0.0.0` so the platform's proxy can reach the app.
pub fn configured(services: Services) -> howdy.App {
  let host = env.get_string_or("HOST", "127.0.0.1")
  let port = env.get_int_or("PORT", 8787)
  let assert True = port > 0 && port <= 65_535 as "PORT must be 1-65535"
  app(services)
  |> howdy.middleware(logger.log)
  |> howdy.bind(host)
  |> howdy.listening(port)
}

pub fn main() -> Nil {
  load_environment()
{{- if .Full}}
  start_telemetry()
{{- end}}
  let db = database()
  // Migrations run at startup so `gleam run` works straight away. For a
  // production deployment you may prefer to migrate separately with
  // `gleam run -m tasks/migrate` and remove this line.
  let assert Ok(_) = database.migrate(db)
  let services = Services(db:)
{{- if .Full}}
  expose(services)
{{- end}}
  let assert Ok(_) = configured(services) |> howdy.start
  process.sleep_forever()
}
